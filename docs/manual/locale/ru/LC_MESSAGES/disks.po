msgstr "ZX Spectrum 128K, +2, +2A"

msgid "ZX Spectrum +3"
msgstr "ZX Spectrum +3"

msgid "+3 drives"
msgstr "дисководы +3"

msgid "Pentagon, Pentagon 1024 SL"
msgstr "Pentagon, Pentagon 1024 SL"

msgid "Beta Disk"
msgstr "Beta Disk"

msgid "Scorpion ZS 256"
msgstr "Scorpion ZS 256"

msgid "Scorpion ZS 256 Turbo+"
msgstr "Scorpion ZS 256 Turbo+"

msgid "SMUC"
msgstr "SMUC"

msgid "ATM Turbo 2+"
msgstr "ATM Turbo 2+"

msgid "ATM Turbo"
msgstr "ATM Turbo"

msgid "Profi v3"
msgstr "Profi v3"

msgid "Profi v5"
msgstr "Profi v5"

